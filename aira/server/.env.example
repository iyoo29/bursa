# ============================================================
# BURSA Server - Environment Configuration Template
# Salin file ini menjadi .env dan sesuaikan nilainya.
# File .env dikecualikan dari Git (.gitignore) demi keamanan.
# ============================================================

# Konfigurasi Jaringan Server
PORT=8000
HOST=127.0.0.1

# Kunci Keamanan API Server (Opsional untuk lingkungan lokal)
# Jika diisi, semua endpoint mutasi mewajibkan header x-bursa-key
# BURSA_API_KEY=kunci_rahasia_anda_disini

# Konfigurasi AI Provider
# Pilihan: mock (default, tanpa biaya), openai, gemini
AI_PROVIDER=mock

# Kredensial AI Provider (Hanya jika menggunakan provider riil)
# JANGAN PERNAH MENULISKAN KUNCI ASLI KE GIT ATAU LAPORAN
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
